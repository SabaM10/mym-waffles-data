# ============================================================
# MyM Waffles Data Platform — Environment Variables Template
# ============================================================
# Copiar este archivo a `.env` y completar con valores reales.
# NO commitear `.env` — está en .gitignore.
# ============================================================

# ------------------------------------------------------------
# Google Sheets — fuente de datos
# ------------------------------------------------------------
# Path al archivo credentials.json del service account.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/credentials.json

# ------------------------------------------------------------
# Sheet de PEDIDOS ("VENTAS 2026")
# ------------------------------------------------------------
# ID del Sheet (parte entre /d/ y /edit en la URL).
GSHEETS_PEDIDOS_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Regex que matchea las pestañas a leer.
# Cada pestaña es un mes (ej: "ENERO 2026", "AGOSTO 2026").
# El pipeline itera todas las que matchean.
# Cuando llegue 2027, cambiás a "^[A-Z]+ 202[67]$" o similar.
GSHEETS_PEDIDOS_TAB_PATTERN=^[A-Z]+ 2026$

# ------------------------------------------------------------
# Sheet de PRECIOS (rate card)
# ------------------------------------------------------------
GSHEETS_PRECIOS_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Nombre exacto de la pestaña con la rate card vigente.
GSHEETS_PRECIOS_TAB=VIGENTES

# ------------------------------------------------------------
# DuckDB — warehouse local
# ------------------------------------------------------------
# Usar path absoluto: los paths relativos rompen dentro del
# subproceso de dagster-dbt.
DUCKDB_PATH=/workspace/data/mym_waffles.duckdb

# ------------------------------------------------------------
# Postgres — capa de serving para Metabase
# ------------------------------------------------------------
POSTGRES_USER=mym
POSTGRES_PASSWORD=mym_dev_pw
POSTGRES_DB=mym_serving
POSTGRES_PORT=5432

# Nombre del servicio de docker-compose si el proceso corre
# dentro del container; `localhost` si corrés desde el host
# (ej. un notebook en el .venv local).
POSTGRES_HOST=postgres

# ------------------------------------------------------------
# Dagster
# ------------------------------------------------------------
DAGSTER_HOME=/opt/dagster/dagster_home

# ------------------------------------------------------------
# dbt
# ------------------------------------------------------------
DBT_PROFILE=mym_waffles
DBT_TARGET=dev

# Directorio donde vive profiles.yml dentro del container.
DBT_PROFILES_DIR=/workspace/dbt_project

# ------------------------------------------------------------
# Metabase
# ------------------------------------------------------------
METABASE_PORT=3001

# ------------------------------------------------------------
# Entorno
# ------------------------------------------------------------
ENVIRONMENT=dev